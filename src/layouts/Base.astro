---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, paths, site, type Lang } from '../content';
interface Props { lang: Lang; page: 'home'|'services'|'work'|'about'|'contact'; }
const { lang, page } = Astro.props;
const meta = t[lang].meta[page];
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const canonical = new URL(paths[lang][page], Astro.site);
const alt = new URL(paths[other][page], Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={alt} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.tr[page], Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ProfessionalService',
      name: site.name, legalName: site.legal, url: 'https://gelengitech.com', telephone: site.phone, email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: 'Akademi Mah. Gürbulut Sk. No:67 H144-C', addressLocality: 'Selçuklu', addressRegion: 'Konya', addressCountry: 'TR' },
      areaServed: 'TR', founder: { '@type': 'Person', name: 'Erhan Özer' },
    })} />
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
